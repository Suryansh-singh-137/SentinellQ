# SentinelIQ Backend Environment Configuration Template
PROJECT_NAME="SentinelIQ AI Risk Platform"
ENVIRONMENT="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Security
SECRET_KEY="replace_with_a_secure_random_key_min_32_characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="postgresql+psycopg://sentineliq:sentineliq_dev_password@localhost:5432/sentineliq"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="sentineliq"
POSTGRES_PASSWORD="sentineliq_dev_password"
POSTGRES_DB="sentineliq"

# Redis Cache & Broker
REDIS_URL="redis://localhost:6379/0"

# CORS
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
